# ============================================================
# vdbbench4es 环境变量配置
# 复制为 .env 后填入实际值：cp .env.example .env
# ============================================================

# ---------- Elasticsearch 连接 ----------

# ES 地址，多个节点用逗号分隔
ES_HOSTS=http://localhost:9200

# 认证用户名
ES_USER=elastic

# 认证密码
ES_PASSWORD=your_password_here

# 是否验证 TLS/SSL 证书（自签证书或 http 连接时设为 false）
ES_VERIFY_CERTS=false

# 当 ES_VERIFY_CERTS=false 时，默认不显示 urllib3 / elasticsearch-py 的
# InsecureRequestWarning，避免测试环境日志被刷屏。
# 如需显式显示 warning，设为 true；如需显式关闭 warning，设为 false。
# ES_SSL_SHOW_WARN=false

# 兼容旧式命名：设为 true 等价于 ES_SSL_SHOW_WARN=false。
# 优先推荐使用 ES_SSL_SHOW_WARN。
# ES_SUPPRESS_INSECURE_WARNING=true

# ---------- 版本兼容 ----------

# elasticsearch-py 客户端与 ES 服务端的兼容版本号。
# 典型场景：pip 安装了 elasticsearch 9.x 客户端，但服务端是 ES 8.x，
# 此时设为 8 即可解决 "Accept found 9" 握手报错。
# 如果客户端与服务端大版本一致（都是 8.x 或都是 9.x），可留空或删除此行。
ES_COMPAT_VERSION=8

# ---------- 数据集存储 ----------

# VDBBench 数据集落盘目录（可选）。
# 默认值：/tmp/vectordb_bench/dataset
# 建议在磁盘空间充足的位置设置永久目录，避免重复下载。
# VDB_DATASET_DIR=/data/vdbbench_data

# ---------- 自定义索引名 ----------

# 自定义 ES 索引名称（可选）。
# 默认值：vdb_bench_indice（VDBBench 内置默认名）
# 设置后，所有操作（创建/删除/写入/搜索）都会使用该名称。
# 典型用途：在同一 ES 中并存多组 benchmark 索引，避免互相覆盖。
# ES_INDEX_NAME=bench_openai_500k
