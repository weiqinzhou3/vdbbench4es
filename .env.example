# Elasticsearch connection info
ES_HOSTS=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=your_password_here
ES_VERIFY_CERTS=false

# ES client compatibility version.
# Set to 8 for ES 8.x, or 7 for ES 7.x.
# Leave empty if client and server versions match exactly.
ES_COMPAT_VERSION=8

# Dataset storage directory (optional).
# Default: /tmp/vectordb_bench/dataset
# VDB_DATASET_DIR=/path/to/your/dataset/dir
